{
  "name": "template",
  "private": true,
  "scripts": {
    "local": "nodemon",
    "start": "NODE_ENV=local ts-node -r tsconfig-paths/register ./index.ts",
    "dev": "pnpm run build && NODE_ENV=development node ./dist/index.js",
    "prod": "pnpm run build && NODE_ENV=production node ./dist/index.js",
    "build": "npx tsc && npx tsc-alias",
    "lint": "eslint . --ext .ts,.js --max-warnings=0",
    "lint:fix": "eslint --fix --ext .js,.ts .",
    "format": "prettier . -w",
    "format:check": "prettier . --check",
    "postinstall": "husky install"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint . --ext .ts,.js --max-warnings=0",
      "prettier . -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier . -w"
    ]
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/http-errors": "^2.0.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/nodemailer": "^6.4.8",
    "@types/passport": "^1.0.12",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/compression": "^1.7.5",
    "@types/ejs": "^3.1.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.2.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "*"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@mailchimp/mailchimp_transactional": "^1.0.59",
    "@sendgrid/mail": "^8.1.5",
    "axios": "^1.9.0",
    "bcrypt": "^5.1.0",
    "body-parser": "^1.20.2",
    "bullmq": "^5.28.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "node-mailjet": "^6.0.8",
    "nodemailer": "^6.9.4",
    "nodemon": "^3.0.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "verify-apple-id-token": "^3.1.2",
    "winston": "^3.14.2"
  }
}
